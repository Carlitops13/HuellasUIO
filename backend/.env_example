# Puerto en el que correrá el servidor Express
PORT=5000

# Credenciales de Supabase
# Obtén estas de: Project Settings > API en tu panel de Supabase
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_ANON_KEY=tu-anon-public-key

# (Opcional) Service Role Key para operaciones administrativas que ignoran RLS
# ADVERTENCIA: Nunca compartas esta clave ni la expongas en el frontend
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key
